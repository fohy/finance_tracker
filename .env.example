# A new database is empty by default. Set to 1 only to explore demo data.
SEED_DEMO=0
HOST=127.0.0.1
PORT=5050
# Generate a unique value before exposing the service beyond your computer.
SECRET_KEY=change-me-before-sharing
# Set to 1 only when the application is served through HTTPS.
SESSION_COOKIE_SECURE=0
# Создайте API-токен в личном кабинете https://proverkacheka.com/
PROVERKACHEKA_TOKEN=
